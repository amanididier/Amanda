{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Amanda",
  "version": "0.1.10",
  "identifier": "com.amanda.desktop",
  "build": {
    "frontendDist": "../dist/client",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "node scripts/prepare-llama-runtime.mjs && bun run dev",
    "beforeBuildCommand": "bun run build:desktop"
  },
  "app": {
    "windows": [
      {
        "title": "Amanda",
        "width": 1180,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:amanda.db"
      ]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMyNkJERUUxREIwRDI1QTkKUldTcEpRM2I0ZDVyTWc3MGJVbHo4VUNGTmpxdFU2cjMvQXhlREdaNVdGYmJGQkNZVHc5ZjFvbysK",
      "endpoints": [
        "https://github.com/amanididier/Amanda/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "resources/llama/*": "llama/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true
  }
}
